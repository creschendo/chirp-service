{
  "name": "chirp-service",
  "version": "0.1.0",
  "description": "Backend API for Chirp, a Twitter clone (Node.js, Express, PostgreSQL, Socket.IO).",
  "type": "module",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:all": "npm run db:up && npm run migrate up && npm run dev",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate": "node-pg-migrate",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db",
    "db:psql": "docker compose exec db psql"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^8.0.0",
    "pg": "^8.16.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0"
  }
}
